# The API connects as wms_app (no superuser, subject to row-level security).
DATABASE_URL=postgres://wms_app:change-me@localhost:5432/wms
# Migrations and company seeding use the owner role.
OWNER_DATABASE_URL=postgres://wms:wms@localhost:5432/wms
JWT_SECRET=change-me-to-a-long-random-string-32+
JWT_TTL_SECONDS=900
PORT=3000
# Used when the sign-in form sends no company.
DEFAULT_COMPANY_SLUG=mycompany
# Seeding a company and its first admin (pnpm db:seed)
COMPANY_NAME=My Dismantling Co
COMPANY_SLUG=mycompany
COMPANY_STATE=CA
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-12+
ADMIN_NAME=Administrator
