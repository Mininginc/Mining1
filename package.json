{
  "name": "dismantler-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @wms/api dev",
    "dev:web": "pnpm --filter @wms/web dev",
    "db:migrate": "pnpm --filter @wms/api db:migrate",
    "db:seed": "pnpm --filter @wms/api db:seed"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
